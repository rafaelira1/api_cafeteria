# Copie para .env e gere uma chave antes de iniciar. Nunca versione o .env.
# python -c "import secrets; from dotenv import set_key; set_key('.env', 'AUTH_JWT_SECRET', secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=

# HTTP apenas para desenvolvimento local explícito.
# Para HTTPS: production, false e origens https:// explícitas.
AUTH_ENVIRONMENT=development
AUTH_ALLOW_INSECURE_HTTP=true
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

AUTH_TOKEN_TTL_MINUTES=30
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=60

# Opcional: utiliza o banco existente, sem removê-lo.
DATABASE_URL=sqlite:///./cafeteria.db
